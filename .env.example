# FIN SIGHT AI - Environment Configuration
# Copy this file to .env and fill in your values

# ============================================================
# LLM Provider Configuration
# Leave blank to run in DEMO MODE (no real LLM calls)
# ============================================================

# Google Gemini (recommended free tier)
GOOGLE_API_KEY=your_google_api_key_here

# OpenAI (alternative)
OPENAI_API_KEY=your_openai_api_key_here

# Anthropic (alternative)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Which LLM provider to use: "gemini", "openai", "anthropic", or "demo"
LLM_PROVIDER=demo

# Model name (depends on provider)
# Gemini: gemini-1.5-flash, gemini-1.5-pro
# OpenAI: gpt-4o-mini, gpt-4o
# Anthropic: claude-3-haiku-20240307
LLM_MODEL=gemini-1.5-flash

# ============================================================
# Application Settings
# ============================================================

# Maximum PDF file size in MB
MAX_FILE_SIZE_MB=50

# Text chunking settings
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Number of chunks to retrieve per query
RETRIEVAL_TOP_K=5

# Embedding model (sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================================
# Logging
# ============================================================
LOG_LEVEL=INFO

# ============================================================
# AWS Settings (for deployment only)
# ============================================================
AWS_REGION=us-east-1
AWS_S3_BUCKET=fin-sight-ai-documents
